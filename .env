# Frontend environment — consumed by Vite only (import.meta.env.VITE_API_URL)
# VITE_API_URL = origin of the Laravel backend (`php artisan serve`).
# The axios client in src/api/axios.js appends '/api' to this value, so keep
# it to just the origin + port, no trailing slash and no path.
VITE_API_URL=http://localhost:8000